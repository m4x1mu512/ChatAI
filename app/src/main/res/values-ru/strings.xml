    <!-- Provider Descriptions -->
    <string name="provider_desc_coarena">Быстрый единый шлюз с OpenAI-совместимым чатом и списком моделей.</string>
    <string name="provider_desc_openai">Модели GPT, reasoning, vision и генерация изображений через OpenAI API.</string>
    <string name="provider_desc_perplexity">Модели Sonar с поиском и опорой на актуальные веб-источники.</string>
    <string name="provider_desc_anthropic">Модели Claude через нативный Anthropic Messages API.</string>
    <string name="provider_desc_claude_code">Профиль Claude, оптимизированный для анализа и генерации кода.</string>
    <string name="provider_desc_gemini">Модели Google Gemini через OpenAI-совместимый endpoint.</string>
    <string name="provider_desc_deepseek">Модели DeepSeek Chat и R1 reasoning с поддержкой OpenAI API.</string>
    <string name="provider_desc_groq">Сверхбыстрый LPU-инференс для Llama, Mixtral и Gemma.</string>
    <string name="provider_desc_openrouter">Единый ключ для доступа к сотням моделей разных провайдеров.</string>
    <string name="provider_desc_grok">Диалоговые и мультимодальные модели Grok от xAI.</string>
    <string name="provider_desc_mistral">Модели Mistral, Codestral и Pixtral.</string>
    <string name="provider_desc_together">Открытые LLM и модели генерации изображений через Together AI.</string>
    <string name="provider_desc_cloudflare">OpenAI-совместимый шлюз Cloudflare Workers AI (требуется Account ID).</string>
    <string name="provider_desc_huggingface">Маршрутизатор Hugging Face Inference Providers для открытых моделей.</string>
    <string name="provider_desc_xai">Прямой endpoint xAI для моделей Grok с поддержкой vision.</string>
    <string name="provider_desc_custom">Подключите Ollama, LM Studio, vLLM, LiteLLM или свой OpenAI-совместимый сервер.</string>

