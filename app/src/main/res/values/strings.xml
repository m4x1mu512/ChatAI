    <!-- Provider Descriptions -->
    <string name="provider_desc_coarena">Fast unified inference gateway with OpenAI-compatible chat and models API.</string>
    <string name="provider_desc_openai">GPT, reasoning, vision, and image generation models via OpenAI API.</string>
    <string name="provider_desc_perplexity">Search-augmented Sonar models with real-time web grounding.</string>
    <string name="provider_desc_anthropic">Claude models powered by the native Anthropic Messages API.</string>
    <string name="provider_desc_claude_code">Claude coding-optimized profile for code analysis and generation.</string>
    <string name="provider_desc_gemini">Google Gemini models via OpenAI-compatible endpoint.</string>
    <string name="provider_desc_deepseek">DeepSeek Chat and R1 reasoning models with OpenAI compatibility.</string>
    <string name="provider_desc_groq">Ultra-low-latency LPU inference for Llama, Mixtral, and Gemma.</string>
    <string name="provider_desc_openrouter">Single key access to hundreds of models across top providers.</string>
    <string name="provider_desc_grok">Grok conversational and multimodal models via xAI API.</string>
    <string name="provider_desc_mistral">Mistral, Codestral, and Pixtral models with European hosting.</string>
    <string name="provider_desc_together">Open-weights LLMs and image models via Together inference.</string>
    <string name="provider_desc_cloudflare">Cloudflare Workers AI OpenAI-compatible gateway (requires Account ID).</string>
    <string name="provider_desc_huggingface">Hugging Face Inference Providers router for open models.</string>
    <string name="provider_desc_xai">Direct xAI endpoint for Grok models and vision capabilities.</string>
    <string name="provider_desc_custom">Connect Ollama, LM Studio, vLLM, LiteLLM, or any OpenAI-compatible server.</string>

